<template name="tus_settings_roms_Emu88">
<head>
	<link type="text/rcss" href="tus_settings_roms_Emu88.rcss"/>
</head>
<body>
	<div class="settings-page">
		<h1>ROMs</h1>
		<settingsspacer1/>
		<h3>ROM Folder</h3>
		<div class="settings-hlayout emu88-rom-row">
			<input id="romPath" class="emu88-rom-path" type="text"/>
			<button id="btBrowse" class="button">Browse...</button>
			<button id="btOpenFolder" class="button">Show</button>
		</div>
		<div class="emu88-rom-note">Searched with everything below it, on top of the plugin's own folder. Leave it empty to use only that one.</div>
		<settingsspacer1/>
		<h3>Plugin ROM Folder</h3>
		<div class="settings-hlayout emu88-rom-row">
			<div id="lbDefaultFolder" class="emu88-rom-note emu88-rom-grow"/>
			<button id="btOpenDefaultFolder" class="button">Show</button>
		</div>
		<settingsspacer1/>
		<h3>Boards</h3>
		<div class="settings-hlayout emu88-rom-row">
			<div id="lbBoards" class="emu88-rom-note emu88-rom-grow"/>
			<button id="btRescan" class="button">Rescan</button>
		</div>
		<!-- One row per board, filled in by SettingsRoms::updateBoards(). The second row is the
		template every board row is cloned from, and is taken out of the table on the way. -->
		<table id="boardTable" class="settings-table emu88-rom-table">
			<tr class="settings-tr emu88-rom-boardrow emu88-rom-boardhead">
				<td class="emu88-col-board">Board</td>
				<td class="emu88-col-state">ROMs</td>
				<td class="emu88-col-files">Files</td>
			</tr>
			<tr id="boardRow" class="settings-tr emu88-rom-boardrow">
				<td id="board" class="emu88-col-board"/>
				<td id="state" class="emu88-col-state"/>
				<td id="files" class="emu88-col-files"/>
			</tr>
		</table>
		<settingsspacer1/>
	</div>
</body>
</template>
